# Бұл файлды .env деп көшіріп, өз мәндеріңізді қойыңыз:
#   cp .env.example .env
#
# .env файлы НИКОГДА GitHub-қа жүктелмеуі керек (.gitignore-де бар).

# Django құпия кілті. Жаңасын генерациялау үшін:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-CHANGE-ME-locally-this-is-not-a-real-secret

# Дамыту (development) кезінде True, production-да міндетті түрде False
DEBUG=True

# Үтірмен бөлінген рұқсат етілген домендер тізімі
ALLOWED_HOSTS=127.0.0.1,localhost

# Render/Railway/PythonAnywhere-да CSRF үшін толық домен қажет болуы мүмкін
CSRF_TRUSTED_ORIGINS=

# PostgreSQL қолданатын болсаңыз (Render/Railway автоматты түрде береді):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Берілмесе — жоба автоматты түрде SQLite қолданады (даму үшін жеткілікті)

# CORS: development-та True, production-да False қойып,
# CORS_ALLOWED_ORIGINS-ты нақты доменмен толтырыңыз
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Production-да HTTPS-ке мәжбүрлі қайта бағыттау
SECURE_SSL_REDIRECT=False
